#!/bin/bash
# brew stub. Controlled by env vars so tests can pick which formulas and
# casks appear installed:
#   BREW_HAS_GIT=1 / BREW_GIT_VERSION=x.y.z
#   BREW_HAS_PNPM=1
#   BREW_TAPS="owner/tap other/tap" / BREW_TAP_FAIL=1
echo "brew $*" >> "$STUB_CALLS"
case "$1" in
  --version)
    echo "Homebrew 4.5.0"
    exit 0 ;;
  install)
    # BREW_INSTALL_FAIL=1 simulates a failed install so the scripts'
    # error and follow-up paths can be exercised.
    [[ "$BREW_INSTALL_FAIL" == "1" ]] && exit 1
    echo "Installing (stub): $*"
    exit 0 ;;
  list)
    # Match on the package name wherever it sits in the arguments, so
    # callers can add flags (brew list --formula pnpm) without the stub
    # reporting the package as absent.
    last_arg="${*: -1}"
    if [[ "$last_arg" == "git" ]] && [[ "$*" == *"--versions"* ]]; then
      if [[ "$BREW_HAS_GIT" == "1" ]]; then
        echo "git ${BREW_GIT_VERSION:-2.55.0}"
        exit 0
      fi
      exit 1
    fi
    if [[ "$last_arg" == "pnpm" ]]; then
      if [[ "$BREW_HAS_PNPM" == "1" ]]; then
        echo "pnpm"
        exit 0
      fi
      exit 1
    fi
    exit 1 ;;
  tap)
    # With no further arguments, report the taps named by BREW_TAPS
    # (space-separated, none by default) the way `brew tap` lists them.
    if [[ $# -eq 1 ]]; then
      [[ -n "$BREW_TAPS" ]] && tr ' ' '\n' <<< "$BREW_TAPS"
      exit 0
    fi
    # BREW_TAP_FAIL=1 simulates a failed tap so the scripts' error and
    # follow-up paths can be exercised.
    [[ "$BREW_TAP_FAIL" == "1" ]] && exit 1
    exit 0 ;;
  *)
    exit 0 ;;
esac
