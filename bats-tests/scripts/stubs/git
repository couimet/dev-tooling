#!/bin/bash
# git stub. Special-cases the calls the freshness check and omz version
# probe make, and delegates everything else (config, etc.) to the real
# git with the test's fake HOME.
#   GIT_STUB_INSIDE_WORK_TREE=1 -> rev-parse --is-inside-work-tree succeeds
#   GIT_STUB_FETCH_FAIL=1       -> fetch fails
#   GIT_STUB_DIFF_DIRTY=1       -> diff against origin/main fails
echo "git $*" >> "$STUB_CALLS"
[[ "$1" == "-C" ]] && shift 2

case "$1" in
  rev-parse)
    case "$2" in
      --is-inside-work-tree)
        [[ "$GIT_STUB_INSIDE_WORK_TREE" == "1" ]] && exit 0 || exit 128 ;;
      --abbrev-ref)
        echo "master"
        exit 0 ;;
      --short)
        echo "abc1234"
        exit 0 ;;
      *)
        exit 0 ;;
    esac ;;
  fetch)
    [[ "$GIT_STUB_FETCH_FAIL" == "1" ]] && exit 1 || exit 0 ;;
  diff)
    [[ "$GIT_STUB_DIFF_DIRTY" == "1" ]] && exit 1 || exit 0 ;;
  *)
    exec /usr/bin/git "$@" ;;
esac
